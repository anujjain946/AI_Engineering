   "source": [
    "import time\n",
    "\n",
    "seconds = int(input(\"Enter seconds: \"))\n",
    "\n",
    "while seconds > 0:\n",
    "    print(seconds, end=\"\\r\")\n",
    "    time.sleep(1)\n",
    "    seconds -= 1\n",
    "\n",
    "print(\"Time's up!\")"
   ]
